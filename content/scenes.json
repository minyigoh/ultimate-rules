        { "t": 4.4, "x": 46, "y": -1.4 }
      ]}
    ],
    "captions": [
      { "t": 0, "text": "Sprinting for a disc drifting toward the line." },
      { "t": 1.4, "text": "Leap, catch it in the air…" },
      { "t": 1.9, "text": "…land in-bounds first. That's what counts." },
      { "t": 2.8, "text": "Momentum carries you out — doesn't matter now." },
      { "t": 3.7, "text": "Walk back and set your pivot where you crossed the line." }
    ]
  },

