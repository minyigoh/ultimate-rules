        { "t": 2.8, "x": 46, "y": -1.4 },
        { "t": 4.4, "x": 46, "y": -1.4 }
      ]},
      { "id": "disc", "role": "disc", "keyframes": [
        { "t": 0, "x": 40, "y": 6 },
