  "in-bounds-feet": {
    "title": "Catch first, then go out",
    "mode": "field",
    "focus": { "x0": 30, "x1": 56, "y0": -4, "y1": 13 },
    "duration": 4.4,
    "actors": [
      { "id": "receiver", "role": "you", "keyframes": [
        { "t": 0, "x": 34, "y": 10 },
        { "t": 1.4, "x": 42, "y": 3.5 },
