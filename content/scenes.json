{
  "pivot-foot": {
    "title": "The pivot foot never moves",
    "mode": "closeup",
    "world": { "halfW": 3, "halfH": 2.2 },
    "duration": 4.2,
    "actors": [
      { "id": "pivot", "role": "you", "keyframes": [{ "t": 0, "x": 0, "y": 0 }, { "t": 4.2, "x": 0, "y": 0 }] },
      { "id": "free", "role": "you2", "keyframes": [
        { "t": 0, "x": 0.5, "y": 0.3 },
        { "t": 1.0, "x": 1.4, "y": -0.5 },
        { "t": 2.0, "x": -1.2, "y": -0.8 },
        { "t": 3.0, "x": -0.3, "y": 1.1 },
        { "t": 4.2, "x": 0.8, "y": 0.7 }
      ]}
    ],
    "links": [{ "a": "pivot", "b": "free" }],
    "captions": [
      { "t": 0, "text": "You catch the disc and plant one foot — your pivot." },
      { "t": 1.0, "text": "The other foot can step anywhere, any distance." },
      { "t": 2.0, "text": "Reach, lunge, spin — the pivot foot never lifts or slides." },
      { "t": 3.3, "text": "Only releasing the throw frees it to move." }
    ]
  },

  "two-contact": {
    "title": "Catch, two contacts, throw",
    "mode": "closeup",
    "world": { "halfW": 4.5, "halfH": 1.8 },
    "duration": 4,
    "actors": [
      { "id": "runner", "role": "you", "keyframes": [
        { "t": 0, "x": -3.2, "y": 0 },
        { "t": 1.0, "x": -1.6, "y": 0 },
        { "t": 1.6, "x": -0.2, "y": 0 },
        { "t": 2.2, "x": 1.2, "y": 0 },
        { "t": 4.0, "x": 1.2, "y": 0 }
      ]},
      { "id": "disc", "role": "disc", "keyframes": [
        { "t": 0, "x": -4.0, "y": 0.9 },
        { "t": 1.0, "x": -1.6, "y": 0 },
        { "t": 1.6, "x": -0.2, "y": 0 },
        { "t": 2.2, "x": 1.2, "y": 0 },
        { "t": 3.2, "x": 3.4, "y": -0.7 },
        { "t": 4.0, "x": 3.4, "y": -0.7 }
      ]}
    ],
    "events": [
      { "t": 1.0, "x": -1.6, "y": 0.55, "tag": "catch" },
      { "t": 1.6, "x": -0.2, "y": 0.55, "tag": "1" },
      { "t": 2.2, "x": 1.2, "y": 0.55, "tag": "2" }
    ],
    "captions": [
      { "t": 0, "text": "Catch it at full sprint — no need to stop." },
      { "t": 1.0, "text": "That catch is the first contact." },
      { "t": 1.6, "text": "One more ground contact is fine…" },
      { "t": 2.2, "text": "…and a second. That's the limit." },
      { "t": 3.0, "text": "Release before a third contact, or it's a travel." }
    ]
  },

