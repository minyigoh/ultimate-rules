__pycache__/
*.pyc
.DS_Store
Thumbs.db

# local dev server config — hardcoded interpreter path, not portable
.claude/

# Intermediate render output. render_v3.py regenerates v4/ on every run: one
# day's five reels is ~1,800 files and 116 MB of frames that rebuild from the
# committed .py files and rules.json. Only the finished .mp4 belongs in git.
content/**/v4/
content/**/frames/

# Discarded slides. The sandbox cannot delete files, so a cut slide gets moved
# into a _to_delete/ folder instead of removed, and then sits there waiting to
# be swept into a commit by a wildcard. content/hook-post-1/_to_delete/ holds
# the superseded 04_close.png.
content/**/_to_delete/

# Scratch for the Windows-side sync helper (tools/sync.bat). The helper itself
# is committed; its logs and the one-shot commit message are not.
/_sync_pull.bat
/_sync_log.txt
/_commit_msg.txt
/_commit_msg2.txt
tools/_last_sync.log
desktop.ini

# Local `wrangler dev` state for worker/lesson-counter. The Worker source and
# its wrangler.toml are committed; the local Durable Object store and dev logs
# are not.
.wrangler/
node_modules/
worker/**/wrangler-dev.log
